{
  "name": "desktop",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gen:types": "cd .. && uv --project voice-sidecar run python tools/gen_frontend_types.py",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "//build": "打包分两半：后端是 jar 加随包 JRE，语音是 PyInstaller 目录。产物落在仓库根 dist/。",
    "build:backend": "cd ../backend && mvn -B -DskipTests package",
    "//runtime": "if 块必须括起来，否则 cmd 会把后面的 && 也算进这个 if，目录不存在时 jlink 一起被跳过。",
    "build:runtime": "(if exist ..\\dist\\backend\\jre rmdir /s /q ..\\dist\\backend\\jre) && jlink --add-modules ALL-MODULE-PATH --strip-debug --no-header-files --no-man-pages --output ../dist/backend/jre && copy /y ..\\backend\\target\\interviewer-backend.jar ..\\dist\\backend\\",
    "build:voice": "cd ../voice-sidecar && uv run pyinstaller --noconfirm --clean --name interviewer-voice --distpath ../dist --paths src --collect-all sounddevice --collect-all websockets src/voice/main.py",
    "bundle": "npm run build:backend && npm run build:runtime && npm run build:voice && npm run tauri build"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
